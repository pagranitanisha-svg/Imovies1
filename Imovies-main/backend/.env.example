PORT=5000
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/imovies?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_unique_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional initial admin creation for `npm run seed`:
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
